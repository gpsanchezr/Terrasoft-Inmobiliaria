# Ejemplo de archivo .env.local
# Copia este archivo a .env.local y completa los valores

# ========================================
# MYSQL DATABASE CONFIGURATION
# ========================================
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=inmobiliaria

# ========================================
# RESEND CONFIGURATION (para correos)
# ========================================
# Obtener de: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx

# ========================================
# ADMIN CONFIGURATION
# ========================================
# Correos con acceso de administrador (separados por comas)
ADMIN_EMAILS=admin@example.com,gestor@example.com

# ========================================
# APP CONFIGURATION
# ========================================
# URL de la aplicación (para links en correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# ========================================
# DATABASE
# ========================================
# Credenciales de base de datos (opcional, si usas herramientas externas)
DATABASE_URL=postgresql://user:password@host:port/database

# ========================================
# SECURITY
# ========================================
# Token secreto para operaciones protegidas
API_SECRET_TOKEN=your_secret_token_here

# ========================================
# FEATURES TOGGLES
# ========================================
# Habilitar/deshabilitar features
NEXT_PUBLIC_ENABLE_PAGOS=true
NEXT_PUBLIC_ENABLE_PQRS=true
NEXT_PUBLIC_ENABLE_ADMIN=true

# ========================================
# ANALYTICS (opcional)
# ========================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# NOTES
# ========================================
# Variables con NEXT_PUBLIC_ son públicas (accesibles en el navegador)
# Variables sin NEXT_PUBLIC_ son privadas (solo servidor)
# Nunca commitear este archivo, usar .gitignore
# En Vercel, configurar en Project Settings > Environment Variables
